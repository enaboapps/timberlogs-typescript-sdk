{
  "name": "timberlogs-client",
  "version": "1.4.2",
  "description": "TypeScript SDK for Timberlogs - structured logging made simple",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "logging",
    "typescript",
    "structured-logging",
    "timberlogs",
    "convex"
  ],
  "author": "enaboapps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timberlogs/timberlogs-typescript-sdk.git"
  },
  "homepage": "https://github.com/timberlogs/timberlogs-typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/timberlogs/timberlogs-typescript-sdk/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
